# Copy to .env.local and fill in. All of these must also be set in Vercel
# project settings for production.

# ── Sanity ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=wllgq317
NEXT_PUBLIC_SANITY_DATASET=production
# Token with WRITE access to the dataset. Used for draft previews AND for
# saving lead profiles from the pre-qualification tool (/eligibility).
SANITY_WRITE_TOKEN=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Used by the contact form and the pre-qualification tool notifications.
RESEND_API_KEY=

# ── AI lead analysis (Anthropic) ───────────────────────────────────────────────
# Powers the AI scoring/summary of pre-qualification leads. Optional:
# without it, leads are still saved and emailed, just without AI analysis.
ANTHROPIC_API_KEY=

# ── Bot protection (Cloudflare Turnstile) ──────────────────────────────────────
# Optional: forms work without these until keys are added.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── CRM sync (HubSpot) ──────────────────────────────────────────────────────
# Private App access token from HubSpot (Settings → Integrations → Private Apps).
# Optional: without it, leads are still saved to Sanity, analyzed, and emailed —
# they just won't sync to HubSpot.
HUBSPOT_ACCESS_TOKEN=

# Your HubSpot account/portal (Hub) ID — numeric, visible in the URL of any
# HubSpot page while logged in, or under Settings → Account Setup → Account Defaults.
# Used only to build deep-link URLs back to the contact/deal.
HUBSPOT_PORTAL_ID=

# Optional overrides: if unset, the code looks up your account's default deal
# pipeline and its first stage via the API at runtime (cached in memory).
# Set these only if you want leads to land in a specific custom pipeline/stage.
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=
