# Copy to .env.local and fill in. All of these must also be set in Vercel
# project settings for production.

# ── Sanity ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=wllgq317
NEXT_PUBLIC_SANITY_DATASET=production
# Token with WRITE access to the dataset. Used for draft previews AND for
# saving lead profiles from the pre-qualification tool (/eligibility).
SANITY_WRITE_TOKEN=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Used by the contact form and the pre-qualification tool notifications.
RESEND_API_KEY=

# ── AI lead analysis (Anthropic) ───────────────────────────────────────────────
# Powers the AI scoring/summary of pre-qualification leads. Optional:
# without it, leads are still saved and emailed, just without AI analysis.
ANTHROPIC_API_KEY=

# ── Bot protection (Cloudflare Turnstile) ──────────────────────────────────────
# Optional: forms work without these until keys are added.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
